# Supabase project settings. The app stays in safe demo mode when these are absent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key for trusted server jobs, signed provider callbacks and billing reconciliation only.
# Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Demo/contact email delivery. Create a Resend API key and verify hisabtech.com.
# All public demo requests are delivered to mahir@hisabtech.com.
RESEND_API_KEY=
DEMO_EMAIL_FROM="Biloo Website <notifications@hisabtech.com>"

# Disabled until merchant activation and acceptance testing are complete.
CHAPA_PAYMENTS_ENABLED=false
CHAPA_MODE=test
# Optional platform billing operators; server-only, comma-separated auth user UUIDs. Requires MFA.
BILLING_ADMIN_USER_IDS=
# Optional authenticated scheduler secret for /api/payments/reconcile.
CRON_SECRET=

# Chapa-hosted ETB checkout. Keep both values server-only.
CHAPA_SECRET_KEY=
# Create a webhook secret in the Chapa dashboard and use the same value here.
CHAPA_WEBHOOK_SECRET=

# Keep false until Chapa checkout, callback delivery, webhook verification and production validation are complete.
# When true, protected workspace access requires an active paid-access period.
BILLING_ENFORCEMENT_ENABLED=false

# Provider callback tokens. Generate separate long random values and keep them server-only.
TELEBIRR_CALLBACK_TOKEN=
MPESA_CALLBACK_TOKEN=

# Public production origin used for auth redirects, Chapa callbacks, return URLs and canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional monitoring endpoint that accepts JSON error events.
MONITORING_WEBHOOK_URL=

# Optional comma-separated allowlist for Content Security Policy connect-src.
CSP_CONNECT_SRC=

# Server/CI backup controls. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=35

# Isolated restore drills require a different disposable database.
RESTORE_DATABASE_URL=
ALLOW_RESTORE_TEST=ISOLATED_TEST_DATABASE
# Optional Search Console URL-prefix verification: use only the content token
# from Google's verification meta tag. Domain properties use a DNS TXT record.
GOOGLE_SITE_VERIFICATION=

# Business invoice collections NEVER use the platform CHAPA_SECRET_KEY.
# Add per-organization credentials only on the server. Replace ORGUUID with the
# organization UUID without hyphens, uppercase, e.g. CHAPA_ORG_AABB..._SECRET_KEY.
# CHAPA_ORG_ORGUUID_SECRET_KEY=
# CHAPA_ORG_ORGUUID_WEBHOOK_SECRET=
